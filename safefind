            }
        }

        function handleAuthSubmit(e) {
            e.preventDefault();
            const username = document.getElementById('auth-username').value.trim();
            const password = document.getElementById('auth-password').value.trim();
            const users = getUsers();

            if (authMode === 'signup') {
                if (users[username]) {
                    showToast('이미 존재하는 익명 아이디입니다.', 'error');
                    return;
                }
                users[username] = { password, points: 50, coupons: [] };
                saveUsers(users);
                setCurrentUser(username);
                closeAuthModal();
                showToast(`환영합니다, ${username}님! 가입 축하 50P가 지급되었습니다.`, 'success');
            } else {
                if (!users[username] || users[username].password !== password) {
                    showToast('아이디 또는 비밀번호가 일치하지 않습니다.', 'error');
                    return;
                }
                setCurrentUser(username);
                closeAuthModal();
                showToast(`${username}님, 로그인되었습니다.`, 'success');
            }
        }

        function handleLogout() {
            setCurrentUser(null);
            showToast('로그아웃되었습니다.', 'info');
        }

        // --- 4. 탭 전환 ---
        function switchTab(tabName) {
            const tabs = ['board', 'chats', 'shop'];
            tabs.forEach(t => {
                const section = document.getElementById(`tab-${t}`);
                const btn = document.getElementById(`tab-btn-${t}`);
