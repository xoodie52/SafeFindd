            const newItem = {
                id: 'item-' + Date.now(),
                type,
                category,
                location,
                description,
                author: currentUser,
                status: 'OPEN',
                createdAt: formattedDate
            };

            const items = getItems();
            items.unshift(newItem);
            saveItems(items);

            closeRegisterModal();
            updateUI();
            showToast('등록이 완료되었습니다! AI가 유사한 물건을 자동으로 분석합니다.', 'success');
        }

        // --- 6. AI 키워드 유사도 매칭 알고리즘 ---
        function calculateSimilarity(itemA, itemB) {
            let score = itemA.category === itemB.category ? 35 : 5;
            const tokenize = (text) => text.toLowerCase().replace(/[^\w\s가-힣]/g, ' ').split(/\s+/).filter(w => w.length >= 2);
            const tokensA = new Set([...tokenize(itemA.location), ...tokenize(itemA.description)]);
            const tokensB = new Set([...tokenize(itemB.location), ...tokenize(itemB.description)]);
            if (tokensA.size === 0 || tokensB.size === 0) return score;

            let matchCount = 0;
            tokensA.forEach(tA => {
                tokensB.forEach(tB => {
                    if (tA === tB || tA.includes(tB) || tB.includes(tA)) matchCount++;
                });
            });

            const maxPossible = Math.max(tokensA.size, tokensB.size);
            const textSimilarity = Math.min(64, Math.round((matchCount / maxPossible) * 65));
            return Math.min(99, score + textSimilarity);
        }

        function renderAIMatches() {
            const items = getItems().filter(i => i.status === 'OPEN');
            const lostItems = items.filter(i => i.type === 'LOST');
            const foundItems = items.filter(i => i.type === 'FOUND');
            const container = document.getElementById('ai-matches-list');

            const matches = [];
            lostItems.forEach(lost => {
                foundItems.forEach(found => {
                    const similarity = calculateSimilarity(lost, found);
                    if (similarity >= 45) matches.push({ lost, found, similarity });
                });
            });
            matches.sort((a, b) => b.similarity - a.similarity);

            if (matches.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full text-center py-6 bg-slate-50 rounded-xl border border-dashed border-slate-200 text-xs sm:text-sm text-slate-500">
                        현재 AI가 탐지한 유사도 45% 이상의 분실물-습득물 매칭 쌍이 없습니다.
                    </div>
                `;
                return;
            }

            container.innerHTML = matches.slice(0, 4).map(m => `
                <div class="bg-indigo-50/40 border border-indigo-100 rounded-xl p-4 flex flex-col justify-between hover:border-indigo-300 transition">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-indigo-700 bg-indigo-100 px-2.5 py-0.5 rounded-full">
                                AI 매칭률 ${m.similarity}%
                            </span>
                            <span class="text-xs text-slate-400 font-medium">${m.found.category}</span>
                        </div>
                        <div class="space-y-1.5 text-xs">
                            <div class="bg-white p-2.5 rounded-lg border border-slate-100">
                                <span class="font-bold text-rose-600">[분실]</span> 
                                <span class="font-semibold text-slate-700">${m.lost.location}</span> - ${m.lost.description}
                            </div>
                            <div class="bg-white p-2.5 rounded-lg border border-slate-100">
                                <span class="font-bold text-emerald-600">[습득]</span> 
                                <span class="font-semibold text-slate-700">${m.found.location}</span> - ${m.found.description}
                            </div>
                        </div>
                    </div>
                    <button onclick="startAnonymousChat('${m.found.id}')" class="mt-3 w-full bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold py-2.5 rounded-xl transition flex items-center justify-center space-x-1.5">
                        <i data-lucide="message-circle" class="w-3.5 h-3.5"></i>
                        <span>익명 채팅하기 (습득자에게 문의)</span>
                    </button>
                </div>
            `).join('');
        }

        // --- 7. 전체 게시판 렌더링 ---
        function renderItemsList() {
            const keyword = document.getElementById('search-input').value.toLowerCase().trim();
            const typeFilter = document.getElementById('filter-type').value;
