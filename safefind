            const currentUser = getCurrentUser();

            let items = getItems().filter(item => {
                const matchType = typeFilter === 'ALL' || item.type === typeFilter;
                const matchCat = catFilter === 'ALL' || item.category === catFilter;
                const matchKeyword = !keyword || 
                    item.location.toLowerCase().includes(keyword) || 
                    item.description.toLowerCase().includes(keyword) ||
                    item.category.toLowerCase().includes(keyword);
                return matchType && matchCat && matchKeyword;
            });

            document.getElementById('items-count').textContent = `총 ${items.length}건`;
            const grid = document.getElementById('items-grid');

            if (items.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 bg-white rounded-2xl border border-slate-200 text-slate-400 text-sm">검색 조건에 맞는 게시글이 없습니다.</div>`;
                return;
            }

            grid.innerHTML = items.map(item => {
                const isLost = item.type === 'LOST';
                const isCompleted = item.status === 'COMPLETED';
                const isMyPost = currentUser && item.author === currentUser;

                return `
                    <div class="bg-white rounded-2xl border ${isCompleted ? 'border-slate-200 opacity-75' : 'border-slate-200 hover:border-indigo-300'} p-5 shadow-sm flex flex-col justify-between transition">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-xs font-bold px-2.5 py-1 rounded-lg ${isLost ? 'bg-rose-50 text-rose-600' : 'bg-emerald-50 text-emerald-600'}">
                                    ${isLost ? '분실했어요 (찾는 중)' : '주웠어요 (보관 중)'}
                                </span>
                                <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2.5 py-1 rounded-lg">
                                    ${item.category}
                                </span>
                            </div>
                            
                            <div class="flex items-center text-xs text-slate-500 mb-2 space-x-1">
                                <i data-lucide="map-pin" class="w-3.5 h-3.5 text-indigo-500"></i>
                                <span class="font-semibold text-slate-700">${item.location}</span>
                            </div>

                            <p class="text-sm text-slate-700 leading-relaxed mb-4">
                                ${item.description}
                            </p>
                        </div>

                        <div class="pt-3 border-t border-slate-100">
                            <div class="flex items-center justify-between text-[11px] text-slate-400 mb-3">
                                <span>작성자: 익명 학생 ${isMyPost ? '<strong class="text-indigo-600">(내 글)</strong>' : ''}</span>
                                <span>${item.createdAt}</span>
                            </div>

                            ${isCompleted ? `
                                <div class="w-full py-2.5 bg-slate-100 text-slate-500 text-xs font-bold rounded-xl text-center">
                                    ✅ 전달 완료됨 (+50P 지급 완료)
                                </div>
                            ` : isMyPost ? `
                                <button onclick="switchTab('chats')" class="w-full py-2.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold rounded-xl transition flex items-center justify-center space-x-1.5">
                                    <i data-lucide="message-square" class="w-3.5 h-3.5"></i>
                                    <span>내 글 채팅 문의 확인하기</span>
                                </button>
                            ` : `
                                <button onclick="startAnonymousChat('${item.id}')" class="w-full py-2.5 bg-slate-900 hover:bg-indigo-600 text-white text-xs font-semibold rounded-xl transition flex items-center justify-center space-x-1.5">
                                    <i data-lucide="message-circle" class="w-3.5 h-3.5"></i>
                                    <span>💬 익명 채팅 시작 (${isLost ? '주인 찾아주기' : '내 물건 문의'})</span>
                                </button>
                            `}
                        </div>
                    </div>
                `;
            }).join('');

            lucide.createIcons();
        }

        // --- 8. 1:1 익명 채팅방 생성 및 관리 ---
        function startAnonymousChat(itemId) {
            const currentUser = getCurrentUser();
            if (!currentUser) {
                showToast('익명 채팅을 시작하려면 먼저 로그인해주세요.', 'error');
                openAuthModal('login');
                return;
            }

            const items = getItems();
            const item = items.find(i => i.id === itemId);
            if (!item) return;

            if (item.author === currentUser) {
                switchTab('chats');
                showToast('본인이 작성한 글입니다. 채팅방 목록에서 문의를 확인하세요.', 'info');
                return;
            }

            const chats = getChats();
            const chatId = `chat-${item.id}-${currentUser}`;
            let existingChat = chats.find(c => c.id === chatId);

            if (!existingChat) {
                // 습득자(finderId) 결정: 게시글이 FOUND면 작성자가 습득자, LOST면 채팅 요청자가 습득자
                const finderId = item.type === 'FOUND' ? item.author : currentUser;
                const now = new Date();
                const timeStr = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;

                existingChat = {
                    id: chatId,
                    itemId: item.id,
                    authorId: item.author,
                    requesterId: currentUser,
                    finderId: finderId,
                    status: 'ACTIVE',
                    messages: [
                        {
                            sender: currentUser,
                            text: item.type === 'FOUND' 
                                ? '안녕하세요! 올리신 습득물 게시글 보고 연락드립니다.' 
                                : '안녕하세요! 잃어버리신 물건을 제가 주워서 보관 중입니다.',
                            time: timeStr
                        }
                    ]
                };
                chats.unshift(existingChat);
                saveChats(chats);
            }

            activeChatId = existingChat.id;
            switchTab('chats');
        }

        function renderChatsTab() {
            const currentUser = getCurrentUser();
            const listContainer = document.getElementById('chat-rooms-list');
            const panelContainer = document.getElementById('active-chat-panel');

            if (!currentUser) {
                listContainer.innerHTML = `<div class="p-6 text-center text-xs text-slate-400">로그인이 필요합니다.</div>`;
                panelContainer.innerHTML = `<div class="flex-grow flex items-center justify-center p-8 text-sm text-slate-400">로그인 후 익명 채팅방을 이용할 수 있습니다.</div>`;
                return;
            }

            const chats = getChats().filter(c => c.authorId === currentUser || c.requesterId === currentUser);
            const items = getItems();

            if (chats.length === 0) {
                listContainer.innerHTML = `<div class="p-6 text-center text-xs text-slate-400">참여 중인 익명 채팅방이 없습니다.<br/>게시판에서 채팅을 시작해보세요!</div>`;
                panelContainer.innerHTML = `
                    <div class="flex-grow flex flex-col items-center justify-center p-8 text-center text-slate-400">
                        <i data-lucide="message-square-dashed" class="w-10 h-10 mb-2 text-slate-300"></i>
                        <p class="text-sm font-medium text-slate-500">선택된 채팅방이 없습니다</p>
                        <p class="text-xs mt-1">분실물 게시판에서 물건을 선택해 익명 대화를 시작하세요.</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            // 활성 채팅방이 없거나 목록에 없으면 첫 번째 채팅방 선택
            if (!activeChatId || !chats.some(c => c.id === activeChatId)) {
                activeChatId = chats[0].id;
            }

            // 왼쪽 채팅방 목록 렌더링
            listContainer.innerHTML = chats.map(chat => {
                const item = items.find(i => i.id === chat.itemId) || { category: '기타', location: '알 수 없음', description: '삭제된 게시글' };
                const isSelected = chat.id === activeChatId;
                const myRole = chat.authorId === currentUser ? '게시글 작성자' : '채팅 요청자';
                const partnerRole = chat.authorId === currentUser ? '채팅 요청자' : '게시글 작성자';
                const lastMsg = chat.messages[chat.messages.length - 1];

                return `
                    <div onclick="selectChatRoom('${chat.id}')" class="p-4 cursor-pointer transition ${isSelected ? 'bg-indigo-50/80 border-l-4 border-indigo-600' : 'hover:bg-white'}">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-xs font-bold text-slate-800">익명 상대 (${partnerRole})</span>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${chat.status === 'COMPLETED' ? 'bg-slate-200 text-slate-600' : 'bg-emerald-100 text-emerald-700'}">
                                ${chat.status === 'COMPLETED' ? '전달완료' : '대화중'}
                            </span>
                        </div>
                        <div class="text-xs font-medium text-indigo-600 truncate mb-1">
                            [${item.category}] ${item.location}
                        </div>
                        <p class="text-xs text-slate-500 truncate">
                            ${lastMsg ? lastMsg.text : '대화를 시작해보세요.'}
                        </p>
                    </div>
                `;
            }).join('');

            // 오른쪽 활성 채팅방 렌더링
            const activeChat = chats.find(c => c.id === activeChatId);
            const targetItem = items.find(i => i.id === activeChat.itemId) || { type: 'FOUND', category: '물품', location: '교내', description: '' };
            const isCompleted = activeChat.status === 'COMPLETED' || targetItem.status === 'COMPLETED';
            const myRoleLabel = activeChat.authorId === currentUser ? '게시글 작성자 (나)' : '채팅 요청자 (나)';
            const partnerRoleLabel = activeChat.authorId === currentUser ? '채팅 요청자 (익명)' : '게시글 작성자 (익명)';
            const amIFinder = activeChat.finderId === currentUser;

            panelContainer.innerHTML = `
                <!-- 채팅방 상단 헤더 -->
                <div class="p-4 border-b border-slate-200 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <div class="flex items-center space-x-2">
                            <span class="font-bold text-slate-900 text-sm">${partnerRoleLabel}</span>
                            <span class="text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md font-medium">내 역할: ${myRoleLabel}</span>
                        </div>
                        <p class="text-xs text-slate-500 mt-0.5">
                            관련 물품: <strong>[${targetItem.category}] ${targetItem.location}</strong> - ${targetItem.description}
                        </p>
                    </div>
                    ${isCompleted ? `
                        <span class="bg-slate-100 text-slate-600 text-xs font-bold px-3 py-2 rounded-xl whitespace-nowrap">
                            ✅ 물건 전달 및 포인트 지급 완료
                        </span>
                    ` : `
                        <button onclick="openCompleteModal('${activeChat.id}')" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-3.5 py-2 rounded-xl shadow-sm transition whitespace-nowrap flex items-center justify-center space-x-1">
                            <span>🤝 물건 전달 완료 (포인트 지급)</span>
                        </button>
                    `}
                </div>

                <!-- 개인정보 보호 안내 배너 -->
                <div class="bg-amber-50 border-b border-amber-200/80 px-4 py-2.5 flex items-center space-x-2 text-xs text-amber-800">
                    <i data-lucide="shield-alert" class="w-4 h-4 text-amber-600 shrink-0"></i>
                    <span><strong>안심 수칙:</strong> 전화번호, 계좌번호 등 개인정보 요구에 주의하고 교내 안전한 장소에서 만나세요.</span>
                </div>

                <!-- 메시지 내역 영역 -->
                <div id="chat-messages-box" class="flex-grow p-4 space-y-3 overflow-y-auto max-h-[300px] bg-slate-50/40">
                    ${activeChat.messages.map(msg => {
                        const isMine = msg.sender === currentUser;
                        const senderRole = msg.sender === activeChat.authorId ? '게시글 작성자' : '채팅 요청자';
                        return `
                            <div class="flex flex-col ${isMine ? 'items-end' : 'items-start'}">
                                <span class="text-[10px] text-slate-400 mb-1 px-1">${isMine ? '나' : senderRole} · ${msg.time}</span>
                                <div class="max-w-[80%] px-3.5 py-2.5 rounded-2xl text-xs sm:text-sm leading-relaxed shadow-2xs ${
                                    isMine 
                                    ? 'bg-indigo-600 text-white rounded-tr-xs' 
                                    : 'bg-white border border-slate-200 text-slate-800 rounded-tl-xs'
                                }">
                                    ${msg.text}
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>

                <!-- 빠른 문구 추천 칩 & 입력창 -->
                <div class="p-3.5 border-t border-slate-200 bg-white space-y-2.5">
                    ${!isCompleted ? `
                        <div class="flex items-center space-x-1.5 overflow-x-auto pb-1">
                            <span class="text-[11px] font-bold text-slate-400 shrink-0">빠른 질문:</span>
                            <button type="button" onclick="sendQuickReply('물건의 세부 특징을 알려주실 수 있나요?')" class="text-[11px] bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-600 px-2.5 py-1 rounded-full whitespace-nowrap transition">
                                물건의 세부 특징을 알려주실 수 있나요?
                            </button>
                            <button type="button" onclick="sendQuickReply('점심시간에 2층 교무실 앞에서 만날까요?')" class="text-[11px] bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-600 px-2.5 py-1 rounded-full whitespace-nowrap transition">
                                점심시간에 2층 교무실 앞에서 만날까요?
                            </button>
                            <button type="button" onclick="sendQuickReply('특징이 일치하네요! 지금 전달해 드릴 수 있습니다.')" class="text-[11px] bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-600 px-2.5 py-1 rounded-full whitespace-nowrap transition">
                                특징이 일치하네요! 전달 가능합니다.
                            </button>
                        </div>
                        <form onsubmit="handleSendMessage(event)" class="flex space-x-2">
                            <input type="text" id="chat-message-input" required placeholder="익명 메시지를 입력하세요 (개인정보 입력 자제)..." 
                                class="flex-grow px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition flex items-center space-x-1">
                                <span>전송</span>
                                <i data-lucide="send" class="w-3.5 h-3.5"></i>
                            </button>
                        </form>
                    ` : `
                        <div class="text-center text-xs text-slate-400 py-2">
                            거래가 완료되어 채팅이 종료되었습니다. (${amIFinder ? '습득 보상으로 +50P가 적립되었습니다!' : '습득자에게 +50P가 지급되었습니다.'})
                        </div>
                    `}
                </div>
            `;

            lucide.createIcons();
            const msgBox = document.getElementById('chat-messages-box');
            if (msgBox) msgBox.scrollTop = msgBox.scrollHeight;
        }

        function selectChatRoom(chatId) {
            activeChatId = chatId;
            renderChatsTab();
        }

        function sendQuickReply(text) {
            const input = document.getElementById('chat-message-input');
            if (input) {
                input.value = text;
                input.focus();
            }
        }

        function handleSendMessage(e) {
            e.preventDefault();
            const input = document.getElementById('chat-message-input');
            const text = input.value.trim();
            const currentUser = getCurrentUser();
            if (!text || !currentUser || !activeChatId) return;

            const chats = getChats();
            const chatIndex = chats.findIndex(c => c.id === activeChatId);
            if (chatIndex === -1) return;

            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;

            chats[chatIndex].messages.push({
                sender: currentUser,
                text,
                time: timeStr
            });

            saveChats(chats);
            input.value = '';
            renderChatsTab();
        }

        // --- 9. 물건 전달 완료 및 습득자 포인트 지급 ---
        function openCompleteModal(chatId) {
            pendingCompleteChatId = chatId;
            document.getElementById('complete-confirm-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function closeCompleteModal() {
            pendingCompleteChatId = null;
            document.getElementById('complete-confirm-modal').classList.add('hidden');
        }

        function confirmCompleteHandover() {
            if (!pendingCompleteChatId) return;
            const chats = getChats();
            const chatIndex = chats.findIndex(c => c.id === pendingCompleteChatId);
            if (chatIndex === -1) return;

            const chat = chats[chatIndex];
            if (chat.status === 'COMPLETED') {
                closeCompleteModal();
                return;
            }

            // 1. 채팅 상태 완료 처리
            chats[chatIndex].status = 'COMPLETED';
            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
            chats[chatIndex].messages.push({
                sender: getCurrentUser(),
                text: '🤝 [시스템] 물건 전달이 완료되었습니다! 습득자에게 +50 포인트가 지급되었습니다.',
                time: timeStr
            });
            saveChats(chats);

            // 2. 게시글 상태 완료 처리
            const items = getItems();
            const itemIndex = items.findIndex(i => i.id === chat.itemId);
            if (itemIndex !== -1) {
                items[itemIndex].status = 'COMPLETED';
                saveItems(items);
            }

            // 3. 습득자(finderId)에게 +50 포인트 지급
            const users = getUsers();
            const finderId = chat.finderId;
            if (users[finderId]) {
                users[finderId].points += 50;
                saveUsers(users);
            }

            closeCompleteModal();
            updateUI();
            showToast(`🎉 전달 완료! 습득자(${finderId})에게 +50P가 지급되었습니다!`, 'success');
        }

        // --- 10. 포인트 보상샵 ---
        function renderShop() {
            const currentUser = getCurrentUser();
            const users = getUsers();
            const pointsEl = document.getElementById('shop-user-points');
            const couponsContainer = document.getElementById('my-coupons-list');

            if (!currentUser || !users[currentUser]) {
                pointsEl.textContent = '로그인 필요';
                couponsContainer.innerHTML = `<div class="col-span-full text-sm text-slate-400 py-4">로그인 후 보유 쿠폰을 확인할 수 있습니다.</div>`;
                return;
            }

            const userData = users[currentUser];
            pointsEl.textContent = `${userData.points} P`;

            if (!userData.coupons || userData.coupons.length === 0) {
                couponsContainer.innerHTML = `<div class="col-span-full text-sm text-slate-400 py-4">아직 교환한 쿠폰이 없습니다. 물건을 찾아주고 포인트로 교환해보세요!</div>`;
                return;
            }

            couponsContainer.innerHTML = userData.coupons.map(c => `
                <div class="border border-indigo-100 bg-indigo-50/40 rounded-xl p-4 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-bold text-indigo-600 bg-white px-2 py-0.5 rounded border border-indigo-100">사용 가능</span>
                            <span class="text-[11px] text-slate-400">${c.date}</span>
                        </div>
                        <h4 class="font-bold text-slate-800 text-sm mt-2">${c.name}</h4>
                    </div>
                    <div class="mt-3 pt-2 border-t border-indigo-100/80 flex items-center justify-between">
                        <span class="text-xs font-mono font-bold text-slate-600">${c.code}</span>
                        <span class="text-[11px] text-indigo-600 font-semibold">학생회/매점 제시</span>
                    </div>
                </div>
            `).join('');
        }

        function redeemReward(rewardName, cost) {
            const currentUser = getCurrentUser();
            if (!currentUser) {
                showToast('보상을 교환하려면 먼저 로그인해주세요.', 'error');
                openAuthModal('login');
                return;
            }

            const users = getUsers();
            const userData = users[currentUser];

            if (userData.points < cost) {
                showToast(`포인트가 부족합니다. (필요: ${cost}P / 보유: ${userData.points}P)`, 'error');
                return;
            }

            userData.points -= cost;
            if (!userData.coupons) userData.coupons = [];

            const randomCode = 'SF-' + Math.random().toString(36).substring(2, 8).toUpperCase();
            const now = new Date();
            const dateStr = `${now.getMonth()+1}/${now.getDate()}`;

            userData.coupons.unshift({
                name: rewardName,
                code: randomCode,
                date: dateStr
            });

            saveUsers(users);
            updateUI();
            showToast(`🎁 '${rewardName}' 교환 완료! 쿠폰함에서 바코드 번호를 확인하세요.`, 'success');
        }

        // --- 11. 전체 UI 동기화 ---
        function updateUI() {
            const currentUser = getCurrentUser();
            const users = getUsers();
            const headerArea = document.getElementById('user-header-area');
            const guestBanner = document.getElementById('guest-banner');

            // 데모 계정 버튼 하이라이트 업데이트
            ['student1', 'student2'].forEach(acc => {
                const desktopBtn = document.getElementById(`demo-btn-${acc}`);
                const mobileBtn = document.getElementById(`demo-btn-m-${acc}`);
                const isActive = currentUser === acc;
                [desktopBtn, mobileBtn].forEach(btn => {
                    if (!btn) return;
                    if (isActive) {
                        btn.className = 'text-xs px-2.5 py-1 rounded-lg font-bold bg-indigo-600 text-white shadow-2xs transition';
                    } else {
                        btn.className = 'text-xs px-2.5 py-1 rounded-lg font-medium text-slate-600 hover:bg-slate-200 transition';
                    }
                });
            });

            // 활성 채팅 뱃지 업데이트
            const chatBadge = document.getElementById('chat-badge-count');
            if (currentUser) {
                const myActiveChats = getChats().filter(c => (c.authorId === currentUser || c.requesterId === currentUser) && c.status === 'ACTIVE');
                if (myActiveChats.length > 0) {
                    chatBadge.textContent = myActiveChats.length;
                    chatBadge.classList.remove('hidden');
                } else {
                    chatBadge.classList.add('hidden');
                }
            } else {
                chatBadge.classList.add('hidden');
            }

            if (currentUser && users[currentUser]) {
                const points = users[currentUser].points;
                guestBanner.classList.add('hidden');
                headerArea.innerHTML = `
                    <div class="flex items-center bg-amber-50 border border-amber-200 px-2.5 sm:px-3 py-1.5 rounded-xl">
                        <i data-lucide="coins" class="w-4 h-4 text-amber-500 mr-1"></i>
                        <span class="text-xs font-extrabold text-amber-700">${points} P</span>
                    </div>
                    <div class="flex items-center space-x-1 text-xs sm:text-sm font-semibold text-slate-700 bg-slate-100 px-2.5 sm:px-3 py-1.5 rounded-xl">
                        <i data-lucide="user" class="w-3.5 h-3.5 text-slate-500"></i>
                        <span>${currentUser}</span>
                    </div>
                    <button onclick="handleLogout()" class="text-xs font-semibold text-slate-500 hover:text-rose-600 px-2 py-1.5 rounded-lg transition">
                        로그아웃
                    </button>
                `;
            } else {
                guestBanner.classList.remove('hidden');
                headerArea.innerHTML = `
                    <button onclick="openAuthModal('login')" class="text-xs sm:text-sm font-semibold text-slate-600 hover:text-indigo-600 px-2.5 py-1.5 transition">
                        로그인
                    </button>
                    <button onclick="openAuthModal('signup')" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-semibold px-3.5 py-2 rounded-xl shadow-sm transition">
                        익명 가입
                    </button>
                `;
            }

            renderAIMatches();
            renderItemsList();
            renderChatsTab();
            renderShop();
            lucide.createIcons();
        }

        window.addEventListener('DOMContentLoaded', () => {
            updateUI();
        });
    </script>
</body>
