            localStorage.setItem(STORAGE_KEYS.USERS, JSON.stringify(users));
        }

        function getCurrentUser() {
            let user = localStorage.getItem(STORAGE_KEYS.CURRENT_USER);
            if (user === null && !localStorage.getItem('safefind_initialized_v2')) {
                // 첫 접속 시 student1로 자동 로그인하여 즉시 체험 가능하도록 설정
                localStorage.setItem('safefind_initialized_v2', 'true');
                localStorage.setItem(STORAGE_KEYS.CURRENT_USER, 'student1');
                return 'student1';
            }
            return user;
        }

        function setCurrentUser(username) {
            if (username) {
                localStorage.setItem(STORAGE_KEYS.CURRENT_USER, username);
            } else {
                localStorage.removeItem(STORAGE_KEYS.CURRENT_USER);
            }
            updateUI();
        }

        function getItems() {
            const data = localStorage.getItem(STORAGE_KEYS.ITEMS);
            if (!data) {
                localStorage.setItem(STORAGE_KEYS.ITEMS, JSON.stringify(DEFAULT_ITEMS));
                return DEFAULT_ITEMS;
            }
            return JSON.parse(data);
        }

